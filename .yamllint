---
extends: default

rules:
  line-length:
    max: 120
  truthy:
    allowed-values: ["true", "false"]
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1

ignore:
  - .venv/
  - build/
  - clab/clab-*/
  - nb-playbooks/inventory/group_vars/all/vault.yml  # vault-encrypted, not plain YAML
  - avd-playbooks/inventory/group_vars/all/vault.yml  # vault-encrypted, not plain YAML
  - avd-playbooks/intended/       # AVD-generated output, not our code
  - avd-playbooks/documentation/  # AVD-generated output, not our code
  - avd-playbooks/anta/           # ANTA-generated catalogs/reports, not our code
  - avd-playbooks/config_backup/  # eos_config_deploy_eapi backups, not our code
