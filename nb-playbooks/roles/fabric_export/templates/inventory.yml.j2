---
# Generated by nb-playbooks/export-model.yml from {{ fabric_export_model.exported_from }}
# at {{ fabric_export_model.exported_at }}. Do not hand-edit -- re-run the export instead.
#
# The top-level group is named after the fabric itself (fabric.name) and
# nests every role group under it -- AVD's eos_designs requires
# fabric_name to be an actual Ansible group containing every fabric host,
# not just a label.
all:
  children:
    {{ fabric_export_model.fabric.name }}:
      children:
{% for role in fabric_export_model.devices | map(attribute='role') | unique | sort %}
        {{ fabric_export_model.fabric.site }}_{{ role }}:
          hosts:
{% for device in fabric_export_model.devices | selectattr('role', 'equalto', role) | sort(attribute='name') %}
            {{ device.name }}:
              ansible_host: {{ device.mgmt_ip.split('/')[0] }}
{% endfor %}
{% endfor %}
