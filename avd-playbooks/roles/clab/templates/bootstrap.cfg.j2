! Rendered from {{ dc1_model.exported_from }} (exported {{ dc1_model.exported_at }}).
! Do not hand-edit -- re-run avd-playbooks/render-clab.yml instead.
!
! Bootstrap config for {{ device.name }}. It is containerlab's default cEOS
! config with one change: management (Management0 and eAPI) already lives in
! vrf MGMT, exactly where the AVD intended config puts it. Without this,
! deploy.yml's first configure replace moves the management interface out
! from under its own eAPI session and Ansible hangs until it times out.
no aaa root
!
username admin privilege 15 role network-admin secret 0 admin
!
transceiver qsfp default-mode 4x10G
!
service routing protocols model multi-agent
!
hostname {{ device.name }}
!
spanning-tree mode mstp
!
system l1
   unsupported speed action error
   unsupported error-correction action error
!
vrf instance MGMT
!
management api http-commands
   no shutdown
   !
   vrf MGMT
      no shutdown
!
management api gnmi
   transport grpc default
      vrf MGMT
!
management api netconf
   transport ssh default
      vrf MGMT
!
interface Management0
   vrf MGMT
   ip address {{ device.mgmt_ip }}
!
no ip routing
no ip routing vrf MGMT
!
ip route vrf MGMT 0.0.0.0/0 {{ (dc1_model.pools.management.split('/')[0].split('.')[:3] + ['1']) | join('.') }}
!
end
