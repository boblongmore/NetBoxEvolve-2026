---
# Rendered from {{ dc1_model.exported_from }} (exported {{ dc1_model.exported_at }}).
# Do not hand-edit -- re-run nb-playbooks/export-model.yml then
# avd-playbooks/render-avd-vars.yml instead.
fabric_name: {{ dc1_model.fabric.name }}
underlay_routing_protocol: {{ dc1_model.settings.underlay }}
overlay_routing_protocol: {{ dc1_model.settings.overlay }}

mgmt_gateway: {{ dc1_model.settings.mgmt_gateway }}
# The OOB interface name override (Management0 for this cEOS image, not
# AVD's Management1 default) lives in spine.yml.j2/leaf.yml.j2 instead of
# here -- pyavd's resolution order for it is node_config (type defaults)
# first, platform_settings second, and only then this fabric-wide var,
# so setting it here alone had no effect. See the comment there.

# Without this, the generated config has no "management api http-commands"
# block at all, and a real config replace removes eAPI along with whatever
# credentials happen to already exist on the box -- confirmed the hard way
# against the live lab. ansible_user/ansible_password come from the same
# vaulted credential already used to connect (inventory/group_vars/all/vault.yml)
# so the fabric keeps using the identical admin account, not a second one.
management_eapi:
  enabled: true

aaa_settings:
  local_users:
    - name: "{{ hostvars[groups['DC1'][0]].ansible_user }}"
      privilege: 15
      role: network-admin
      cleartext_password: "{{ hostvars[groups['DC1'][0]].ansible_password }}"
      password_type: sha512

dns_settings:
  servers:
{% for server in dc1_model.settings.dns_servers %}
    - ip_address: {{ server }}
{% endfor %}

ntp_settings:
  servers:
{% for server in dc1_model.settings.ntp_servers %}
    - name: {{ server }}
{% endfor %}

# Symmetric IRB via EVPN doesn't need a per-VRF transport SVI, so the
# L3VNI placeholder VLAN in NetBox (reserved for Nexus as Code, which
# does need one) has nothing to map to here -- only VLANs with a VNI
# become AVD SVIs.
tenants:
{% for vrf in dc1_model.vrfs %}
  - name: {{ vrf.tenant }}
    vrfs:
      - name: {{ vrf.name }}
        vrf_vni: {{ vrf.vni }}
        # No rd_override: NetBox deliberately doesn't store an RD (see
        # 50-overlay.yml) since it's per-device -- AVD's default RD is
        # <router_id>:<vrf_vni> (each leaf's own Loopback0 IP), so it
        # derives a unique, correct RD per PE with no input needed here.
        # AVD auto-derives the MLAG-per-VRF iBGP peering VLAN from vrf_vni
        # when vrf_id isn't set, which for a 5-digit VNI produces a VLAN ID
        # above 4094 -- invalid, and rejected outright by EOS on config
        # replace (confirmed against the live lab: "vlan 53000" from
        # vrf_vni 50001). This feature is optional extra resiliency for
        # the MLAG pair's VRF-aware routing, not required for correctness
        # here, so it's simplest to disable it rather than plumb a second
        # small integer identifier into the model just for this formula.
        enable_mlag_ibgp_peering_vrfs: false
        svis:
{% for vlan in dc1_model.vlans | selectattr('vni', 'ne', none) %}
          - id: {{ vlan.vid }}
            name: {{ vlan.name }}
            vni_override: {{ vlan.vni }}
            ip_address_virtual: "{{ vlan.gateway }}"
{% endfor %}
{% endfor %}
