---
exclude_paths:
  - .venv/
  - build/
  - clab/clab-*/
  - .yamllint
  # ansible-lint resolves exclude_paths relative to wherever it's invoked
  # from, not this file's location -- both forms are listed since
  # nb-playbooks/avd-playbooks commands are run from inside each dir.
  - intended/                     # AVD-generated output, not our code
  - documentation/                # AVD-generated output, not our code
  - avd-playbooks/intended/
  - avd-playbooks/documentation/

use_default_rules: true

skip_list:
  - yaml[line-length]  # enforced by yamllint instead
  # False positive: every nb-playbooks role relies on the play-level
  # module_defaults group (netbox_url/netbox_token) set in load-model.yml.
  # ansible-lint checks roles in isolation and can't see that, so it always
  # flags these as missing -- they aren't, at runtime.
  - args[module]
